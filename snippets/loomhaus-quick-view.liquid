{% comment %}
  Loomhaus Quick View Popup (Desktop Modal / Mobile Bottom Sheet)
  devx labs Assignment - 100% Matching Figma Design
{% endcomment %}

<div class="lh-quickview-backdrop" id="LoomhausQuickViewBackdrop" role="dialog" aria-modal="true" aria-labelledby="LhQvTitle">
  <div class="lh-quickview-modal">
    <!-- Mobile drag handle -->
    <div class="lh-qv-drag-handle"></div>

    <div class="lh-quickview-body">
      <!-- Left: Product Image (Portrait 3/4) -->
      <div class="lh-qv-image-wrap">
        <img id="LhQvImage" src="" alt="Product Quick View" loading="lazy">
      </div>

      <!-- Right: Details, Swatches & Size -->
      <div class="lh-qv-info">
        <div class="lh-qv-header-row">
          <h3 class="lh-qv-title" id="LhQvTitle">Product Title</h3>
          <button type="button" class="lh-quickview-close" id="LhQvClose" aria-label="Close Quick View">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <div class="lh-qv-price" id="LhQvPrice">₹0.00</div>

        <p class="lh-qv-desc" id="LhQvDesc">
          Long-sleeved navy waterproof jacket in thin polyester with a soft mesh inside. Keeps you dry in all weather.
        </p>
        
        <!-- Color Option (Figma Swatch Buttons) -->
        <div class="lh-qv-option-group" id="LhQvColorGroup">
          <div class="lh-qv-label">COLOR</div>
          <div class="lh-qv-color-swatches" id="LhQvColorSwatches">
            <!-- Dynamically populated via JS: [ ● Black ] [ ○ White ] -->
          </div>
        </div>

        <!-- Size Option Dropdown -->
        <div class="lh-qv-option-group" id="LhQvSizeGroup">
          <div class="lh-qv-label">SIZE</div>
          <div class="lh-qv-select-wrap">
            <select id="LhQvSelect" class="lh-qv-select" aria-label="Choose your size">
              <option value="" disabled selected>Choose your size</option>
            </select>
            <div class="lh-qv-select-arrow">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </div>
        </div>

        <!-- Add to Cart Button -->
        <button type="button" id="LhQvAddToCart" class="lh-qv-add-btn">
          <span>ADD TO CART</span>
          <span style="font-size: 16px;">&rarr;</span>
        </button>
      </div>
    </div>
  </div>
</div>
