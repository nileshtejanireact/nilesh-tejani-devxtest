{% comment %}
  Loomhaus Custom Footer
  devx labs Assignment
{% endcomment %}

<footer class="lh-footer-section">
  <div class="lh-container">
    <div class="lh-footer-grid">
      <!-- Brand Column -->
      <div>
        <div class="lh-footer-logo">{{ section.settings.logo_text | default: 'Loomhaus' }}</div>
        <p class="lh-footer-tagline">
          {{ section.settings.tagline | default: 'Warm layers. Honest fabrics. For everyday adventures.' }}
        </p>
      </div>

      <!-- Shop Column -->
      <div>
        <div class="lh-footer-heading">SHOP</div>
        <ul class="lh-footer-links">
          <li><a href="/collections/all">About</a></li>
          <li><a href="/collections/all">Men</a></li>
          <li><a href="/collections/all">Women</a></li>
          <li><a href="/collections/all">Journal</a></li>
          <li><a href="/pages/contact">Contact</a></li>
        </ul>
      </div>

      <!-- Help Column -->
      <div>
        <div class="lh-footer-heading">HELP</div>
        <ul class="lh-footer-links">
          <li><a href="/pages/contact">FAQ</a></li>
          <li><a href="/policies/shipping-policy">Shipping</a></li>
          <li><a href="/policies/refund-policy">Returns</a></li>
          <li><a href="/pages/contact">Size guide</a></li>
          <li><a href="/pages/contact">Contact us</a></li>
        </ul>
      </div>
    </div>

    <div class="lh-footer-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} Loomhaus. All rights reserved.</span>
      <span>Direct Factory Standards &middot; Organic Bio-Washed Apparel</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Loomhaus Footer",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Brand Logo",
      "default": "Loomhaus"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Warm layers. Honest fabrics. For everyday adventures."
    }
  ],
  "presets": [
    {
      "name": "Loomhaus Footer"
    }
  ]
}
{% endschema %}
